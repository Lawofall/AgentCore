{
  "name": "agentcore-mobile",
  "version": "0.4.9",
  "private": true,
  "type": "module",
  "description": "AgentCore Mobile - 手机端 web 客户端 (桌面端减能力层; 前端技术与架构 §七)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ && node ../../scripts/check-ui-tokens.mjs --src apps/mobile/src",
    "lint:fix": "biome check --write src/",
    "check-ui-tokens": "node ../../scripts/check-ui-tokens.mjs --src apps/mobile/src",
    "test": "vitest",
    "conformance": "tsx src/protocol/conformance.run.ts",
    "shot": "node scripts/shot.cjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "cap:sync": "pnpm build && cap sync",
    "android:open": "cap open android",
    "android:sync-version": "node scripts/sync-android-version.mjs",
    "android:assemble": "node scripts/assemble-android.mjs",
    "release:android": "node scripts/release-android.mjs"
  },
  "dependencies": {
    "@agentcore/contract-rest-types": "workspace:*",
    "@agentcore/contract-types": "workspace:*",
    "@agentcore/design-tokens": "workspace:*",
    "@agentcore/protocol-conformance": "workspace:*",
    "@agentcore/protocol-fold-kit": "workspace:*",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-speech-recognition": "^8.1.9",
    "katex": "^0.17.0",
    "lucide-react": "^0.400.0",
    "mermaid": "^11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@capacitor/cli": "^8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
