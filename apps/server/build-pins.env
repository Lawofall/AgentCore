# Image pins for api + guest-base. Bumping any line changes guest-base id
# (see deploy/scripts/guest-base-id.mjs) and rebuilds the slow guest rootfs.
# Refresh PYTHON_IMAGE with: docker buildx imagetools inspect python:3.12-slim
PYTHON_IMAGE=python:3.12-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2
PLAYWRIGHT_VERSION=1.61.0
# Production (CN) Playwright browser CDN. GHA passes empty to use the official host.
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
