{
  "name": "agentcore-desktop",
  "version": "0.9.21",
  "description": "AgentCore Desktop - Multi-Agent AI Workspace",
  "author": "AgentCore",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:webapp": "vite --config vite.webapp.config.ts",
    "shoot": "node scripts/shoot.mjs",
    "shoot:manual": "node scripts/shoot-manual.mjs",
    "shoot:whiteboard": "node scripts/shoot-whiteboard.mjs",
    "shoot:ask-commence": "node scripts/shoot-ask-commence.mjs",
    "shoot:onboarding": "node scripts/shoot-onboarding.mjs",
    "shoot:conversations": "node scripts/shoot-conversations.mjs",
    "shoot:files": "node scripts/shoot-files.mjs",
    "shoot:settings": "node scripts/shoot-settings.mjs",
    "shoot:toolbox": "node scripts/shoot-toolbox.mjs",
    "shoot:capability-packs": "node scripts/shoot-capability-packs.mjs",
    "shoot:graph-probe": "node scripts/shoot-graph-probe.mjs",
    "shoot:graph-perf": "node scripts/shoot-graph-perf.mjs",
    "shoot:graph-perf-live": "node scripts/shoot-graph-perf-live.mjs",
    "shoot:graph-perf-trace": "node scripts/shoot-graph-perf-trace.mjs",
    "shoot:graph-perf-ab": "node scripts/shoot-graph-perf-ab.mjs",
    "shoot:graph-missing": "node scripts/shoot-graph-missing.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:webapp": "node scripts/smoke-webapp.mjs",
    "smoke:webapp:ci": "node scripts/smoke-webapp.mjs --boot",
    "promo:lv": "node scripts/promo_capture_lv_molihua.mjs",
    "promo:lv:full": "node scripts/promo_capture_lv_molihua.mjs full",
    "promo:lv:repair": "node scripts/promo_capture_lv_molihua.mjs repair",
    "promo:lv:speed1": "node scripts/promo_capture_lv_molihua.mjs speed1-clip",
    "build": "electron-vite build",
    "build:webapp": "vite build --config vite.webapp.config.ts",
    "deploy:web": "node scripts/deploy-web.mjs",
    "release:win": "node scripts/release-win.mjs",
    "generate:beta-icons": "node scripts/generate-beta-icons.mjs",
    "preview": "electron-vite preview",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "fetch:rg": "node scripts/fetch-rg.mjs",
    "build:unpack": "pnpm bundle:sidecar && electron-vite build && electron-builder --config electron-builder.config.mjs --dir",
    "build:win": "pnpm bundle:sidecar && electron-vite build && electron-builder --config electron-builder.config.mjs --win",
    "build:win:cn": "node scripts/build-win-cn.mjs",
    "build:mac": "pnpm bundle:sidecar && electron-vite build && electron-builder --config electron-builder.config.mjs --mac --arm64",
    "build:linux": "pnpm bundle:sidecar && electron-vite build && electron-builder --config electron-builder.config.mjs --linux",
    "lint": "biome check src/ && node ../../scripts/check-ui-tokens.mjs --src apps/desktop/src/renderer && node ../../scripts/check-no-localstorage.mjs --src apps/desktop/src/renderer",
    "lint:fix": "biome check --write src/",
    "check-ui-tokens": "node ../../scripts/check-ui-tokens.mjs --src apps/desktop/src/renderer",
    "test": "vitest",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "typecheck": "tsc --noEmit",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "postinstall": "node ./scripts/install-electron.mjs && node ./scripts/rebuild-native.mjs"
  },
  "build": {
    "extends": "./electron-builder.config.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.5",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "perfect-freehand": "^1.2.3",
    "react-material-icon-theme": "1.2.0",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@agentcore/contract-rest-types": "workspace:*",
    "@agentcore/contract-types": "workspace:*",
    "@agentcore/design-tokens": "workspace:*",
    "@agentcore/graph-layout": "workspace:*",
    "@agentcore/protocol-conformance": "workspace:*",
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capgo/capacitor-speech-recognition": "^8.1.9",
    "@agentcore/protocol-fold-kit": "workspace:*",
    "@biomejs/biome": "^1.9.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.4",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "1.61.0",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.0.0",
    "autoprefixer": "^10.4.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.9.0",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.400.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.1",
    "playwright": "1.61.0",
    "postcss": "^8.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vega-embed": "^7.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "zustand": "^5.0.0"
  }
}
