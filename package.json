{
  "name": "agentcore",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "conformance": "pnpm -r run conformance",
    "gen:types": "node scripts/gen-types.mjs",
    "sync:legal": "node scripts/sync-legal-md.mjs",
    "sync:legal:check": "node scripts/sync-legal-md.mjs --check",
    "check:doc-sections": "node scripts/check-doc-section-pointers.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:gate:lite": "node scripts/release-gate.mjs --lite",
    "release:ship": "node scripts/release-ship.mjs",
    "release:notice": "node scripts/release-notice.mjs",
    "ports:free": "node scripts/free-listen-port.mjs",
    "audit:deps:py": "cd apps/server && uv run --with pip-audit pip-audit",
    "audit:deps:js": "pnpm audit --prod",
    "audit:deps": "node scripts/audit-deps.mjs",
    "test:server": "cd apps/server && uv run pytest --tb=short -q",
    "test:server:unit": "cd apps/server && uv run pytest --ignore=tests/integration --tb=short -q -n auto",
    "test:server:cov": "cd apps/server && uv run pytest --cov=agentcore --cov-report=term-missing --ignore=tests/integration --tb=short -q",
    "test:server:slow": "cd apps/server && uv run pytest --durations=20 -q",
    "deploy:backend": "node deploy/scripts/remote-build-deploy.mjs",
    "deploy:backend:status": "node deploy/scripts/check-remote-build.mjs",
    "publish:notice": "node deploy/scripts/publish-product-notice.mjs",
    "publish:notice:help": "node scripts/release-notice.mjs --help",
    "sync:release-cdn": "node deploy/scripts/sync-release-cdn.mjs",
    "probe:updater-cdn": "node deploy/scripts/probe-updater-cdn.mjs",
    "check:capacitor-cors": "node deploy/scripts/check-capacitor-cors.mjs",
    "sync:logs": "node scripts/sync-prod-logs.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty"
    ],
    "overrides": {
      "@radix-ui/react-slot": "1.3.0",
      "@radix-ui/react-focus-scope": "1.1.16",
      "@radix-ui/react-dismissable-layer": "1.1.19",
      "esbuild": "^0.25.0",
      "js-yaml": "^4.3.0",
      "tar": "^7.5.21",
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^2.0.0": "2.1.4",
      "brace-expansion@^5.0.0": "5.0.9",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0",
      "react-router": "^7.18.2",
      "react-router-dom": "^7.18.2",
      "fast-uri": ">=3.1.4",
      "linkify-it": ">=5.0.2",
      "immutable": "^4.3.9",
      "dompurify": "^3.4.13",
      "nanoid@^3.0.0": "^3.3.18",
      "undici@^6.0.0": "^6.28.0",
      "undici@^7.0.0": "^7.29.0",
      "hono": "^4.12.34"
    }
  }
}
