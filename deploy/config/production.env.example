# AgentCore 生产环境变量模板
#
# 用法：在服务器复制为 deploy/config/production.env（已被 .gitignore 忽略，含真实密钥），
# 填好后由 compose 与应用共用：
#   docker compose -f deploy/docker-compose.server.yml --env-file deploy/config/production.env up -d
#   后端（宿主机 uv/systemd）从同一文件加载（或软链到 apps/server/.env）。
#
# ⚠️ 切勿提交真实密钥；所有 CHANGE_ME 占位值上线前必须替换为强随机值。

# ── Compose 基础设施密钥（被 docker-compose.server.yml 插值）──
POSTGRES_PASSWORD=CHANGE_ME_pg_password
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── 应用镜像（被 docker-compose.app.yml 插值；CI 构建推 ACR，部署脚本设 IMAGE_TAG=<sha>）──
# IMAGE_REGISTRY 含命名空间，结合 image: ${IMAGE_REGISTRY}/api:${IMAGE_TAG}。
# 占位示例；生产填真实 ACR/镜像仓库（如 registry.example.com/your-namespace）。
IMAGE_REGISTRY=registry.example.com/your-namespace
IMAGE_TAG=latest
# ACR 登录凭据仅 deploy-server.sh 用（compose 不读）；可改放 $AGENTCORE_HOME/.env。
# ACR_USERNAME=CHANGE_ME
# ACR_PASSWORD=CHANGE_ME

# ── Database / Redis（应用连接串，密码需与上面一致；绑 127.0.0.1）──
DATABASE_URL=postgresql+asyncpg://agentcore:CHANGE_ME_pg_password@127.0.0.1:5432/agentcore
REDIS_URL=redis://:CHANGE_ME_redis_password@127.0.0.1:6379/0

# ── 计费形态 + 平台 LLM 上游（成本配额与计费.md §〇·六 · 平台 LLM §五·附）──
# 目标形态：BILLING_MODE=platform（全员代付 · ¥10/月配额组）。dev / 本地默认仍 byok。
# 现网可临时切 byok 休眠平台代付（无 Key → 402）；再开 = 改回 platform 并重启 api。
BILLING_MODE=platform
# 现网定案：OpenCode Go + 仅 deepseek-v4-flash（同一把 Zen 控制台 key，换端点不换 key）。
PLATFORM_API_KEY=CHANGE_ME
PLATFORM_BASE_URL=https://opencode.ai/zen/go/v1
PLATFORM_MODEL=deepseek-v4-flash
PLATFORM_MODELS=deepseek-v4-flash
PLATFORM_BACKGROUND_MODEL=deepseek-v4-flash
# 一 key 一模型覆盖（JSON）；空 = 全走 PLATFORM_API_KEY。可选条目 id / PLATFORM_CREDENTIAL_ID 为运维别名（日志与 cost_calls，非 key 明文）。
# PLATFORM_MODEL_CREDENTIALS=
# PLATFORM_CREDENTIAL_ID=
# 本阶段不配 VISION_*（白板读图仅用户 BYOK 填 vision 槽）。

# ── 配额默认（nano-CNY 台账；无 FREE_TIER / QUOTA_*_USD）──
QUOTA_DAILY_TOKENS=0
QUOTA_MONTHLY_COST_CNY=10
QUOTA_DAILY_COST_CNY=10
QUOTA_DAILY_REQUESTS=500

# ── BYOK 凭据加密主密钥（AES-256-GCM, 64 hex = 32 字节）──
# 加密用户自带 API Key 后落库（security.py KeyEncryptor）。
# billing_mode=byok 下为**必填**；platform 下 BYOK 为高级选项，仍建议配置以便用户绑自有 key。
# （服务仍能启动，但模型配置页报「未配置加密主密钥」——boots green 却功能死）。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 一经启用切勿更换——换 key 会使所有已存 Key 无法解密。
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ── Web search（SearXNG 主搜 + 可选 Tavily 备腿）──
# 宿主机 API → 默认与 config/search.py / .env.example 一致：http://localhost:18888
# （compose 将 SearXNG 绑在本机 18888→容器 8080）。API 进同一 compose 网络时改
# http://searxng:8080。api 不 depends_on searxng：未就绪则启动 probe 降级，web_search 暂不可用。
SEARXNG_URL=http://localhost:18888
# 生产建议配备用：SearXNG 主失败（熔断 / 传输 / 持续 5xx）时 web_search 再试一次 Tavily。
# 空 = 无备腿（纯 SearXNG）。密钥 https://tavily.com ；勿把占位提交进仓。
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com

# ── JWT / Auth ──
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Sliding window (tokens rotate + re-stamp expiry on every use): max idle gap
# before a forced re-login. 30d so users aren't bounced to login after a break.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
INFERENCE_TOKEN_EXPIRE_MINUTES=120
INFERENCE_TOKEN_MINT_MAX=10
INFERENCE_TOKEN_MINT_WINDOW_SECONDS=60

# CSRF is a stateless signed token on a response header (no Redis store, no cookie);
# leaving it off boots with a loud warning, not a refusal.
# RATE_LIMIT_BACKEND=redis shares limiters across workers; cost ledger uses shared
# Postgres cost_ledger_outbox. Neither unlocks multi-worker — see below.
# 【多 worker 一律拒启】WEB_CONCURRENCY / UVICORN_WORKERS / AGENTCORE_API_WORKERS > 1
# 启动即 RuntimeError（DEBUG 仅警告）。两处进程内单例没有共享后端可切：
#   1. 设备履约中枢（agentcore/fulfill/hub.py）——桌面履约 SSE 连在 worker A，回合却
#      可能跑在 worker B，B 查不到任何履约方（本地工作区 / Host / MCP / 白板 全断），
#      本地工作区回合更会被在场闸判成「本机桌面未连接」直接硬拒（不是降级重试）。
#   2. 对话事件流（runtime/events/conversation_hub.py）——attach / 跟播落到没跑该回合
#      的 worker 上只会一直心跳，客户端分辨不出它和「对话真空闲」的区别（静默失效）。
# 放开的前置是跨进程扇出，不是任何环境变量；故有意不留 opt-in 逃生阀。见 部署拓扑 §六。
# Other bits (approval / IM / steer / journal) also assume one process.
CSRF_ENABLED=true
RATE_LIMIT_BACKEND=redis
TRUST_PROXY=true

# Public registration (开放注册). Set false to emergency-close signups.
REGISTRATION_OPEN=true

# Immediate-create POST /v1/auth/register (即时建号). Independent of DEBUG — turning
# DEBUG on for triage must not reopen unverified signup. Public signup goes through
# /v1/auth/register/send-code; keep this false in production.
LEGACY_REGISTER_ENABLED=false

# Require a verified inbox to log in. Legacy accounts predate email verification,
# so this stays false until they have had a chance to catch up.
REQUIRE_EMAIL_VERIFIED=false

# ── 验证码发信（通用 SMTP，无厂商 SDK；阿里云 DirectMail / 腾讯云 SES / SendCloud 均可）──
# 【生产必配】REGISTRATION_OPEN=true 时须填齐下列七项；留空 = 不发信：非 DEBUG 只记
# email.unconfigured，POST /v1/auth/register/send-code 仍回 202 但用户收不到验证码。
# 本文件由运维在服务器手工维护（git pull 不会覆盖）；部署脚本只读、只改 IMAGE_TAG。
# 七项变量名（模板勿填真实凭据）：
#   SMTP_HOST SMTP_PORT SMTP_USERNAME SMTP_PASSWORD
#   SMTP_FROM_ADDRESS SMTP_FROM_NAME SMTP_TLS_MODE
# 前置：发信域名（建议 mail. / notify. 子域）配好 SPF / DKIM / DMARC / MX 并在服务商侧验证通过。
# SMTP_USERNAME 必须与 SMTP_FROM_ADDRESS 一致（DirectMail 要求）。
# 阿里云 ECS 封 25 端口——用 465 (ssl) 或 80/587 (starttls)。
# 填好后在 api 容器内验收（示例收件箱自行替换）：
#   docker compose -p agentcore -f docker-compose.server.yml -f docker-compose.app.yml \
#     --env-file config/production.env exec api \
#     python scripts/verify_smtp.py you@example.com
# 启动日志若见 email.smtp_unconfigured_registration 即仍未配齐 SMTP_HOST + SMTP_FROM_ADDRESS。
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=AgentCore
SMTP_TLS_MODE=ssl

# ── 云端代码执行（gVisor，安全权限与治理.md §五 / 部署拓扑与环境.md §云端执行）──
# 【默认开】代码默认 gvisor_enabled=true；deploy/finish 默认叠 sandbox compose。
# 部署 AI **不必**再决定「开不开」——缺省即有云执行面。
# 紧急关闭：下行改 false 后 finish-server（健康探测失败时也会诚实不装配）。
# 开启前置：镜像内已装 runsc；叠 docker-compose.sandbox.yml
# （seccomp/AppArmor + NET_ADMIN/SYS_ADMIN + api-sandbox-entrypoint 降权 + 内存余量）。
# 云 browser_* / package_install 另需该 overlay 的 netns 能力；不要 privileged:true。
# 开启后云端 worker 注册 code_execute/test_run，执行免审批（AUTO_PASS，真隔离）。
# runsc 缺失 / 沙箱不健康 → 不拒启，打 sandbox.cloud_health_failed，执行类不装配。
GVISOR_ENABLED=true
# GVISOR_RUNSC_PATH=runsc
# runsc 状态目录须在 DATA_DIR 卷上（勿用 /tmp——容器 overlay 上 mkdir 会 EINVAL）。
# compose.app 已默认注入 /data/sandbox；非容器或自定义卷时显式设置：
# GVISOR_RUNTIME_ROOT=/data/sandbox
# 护栏（2C8G 单机起步值；按真实负载调）：
#   并发上限 + 有界等待（排队最多 N 秒，超时快速失败并向模型解释「执行位已满」）
# GVISOR_MAX_CONCURRENT_EXECUTIONS=2
# GVISOR_SLOT_WAIT_SECONDS=15
#   单次执行硬顶：内存（OCI cgroup）；时长 = 外环灾难顶安全网 cap（非 idle；超时杀进程、不写回产物）
# GVISOR_MEMORY_LIMIT_MB=512
# 代码默认 1230（≥ 外环灾难顶 1200s + slack）。idle 挂起另计（默认 60 / install 120）。勿照抄 60——会夹死外环 verify。
# GVISOR_TIMEOUT_MAX_SECONDS=1230
#   产物写回（copy-in/copy-out）限额：载入沙箱的工作区体积 / 写回产物总量与文件数
# GVISOR_STAGE_MAX_BYTES=536870912
# GVISOR_WRITE_BACK_MAX_BYTES=134217728
# GVISOR_WRITE_BACK_MAX_FILES=200
# 云浏览器 runsc 非 rootless。Docker 内 cgroup2 只读时进程会自动加 --ignore-cgroups
# （打 browser.cgroup_unwritable_ignore）；只需强制跳过会话 OCI cgroup 限额时才显式打开：
# BROWSER_SANDBOX_IGNORE_CGROUPS=true

# 无 gVisor 的裸 subprocess 云执行逃生口：保持关闭（等于容器内 RCE，见 SEC-005）。
# CODE_EXECUTE_CLOUD_ENABLED=false
# 装包（test_run install）另需容器内 netns/registry_egress（与 browser 同探针）；
# 仅健康探测够跑 code_execute，≠ package_install 已装配。能力行拆 code_execute= / package_install=。
# 桌面端打包后 renderer 的 origin = app://agentcore（前端技术与架构.md §7.2）。
# 独立手机网页站已下线，不要再把 https://m.example.com 加回 allow-list。
# Capacitor 安卓壳 WebView origin = https://localhost（另保留 capacitor://localhost / http://localhost）。
# 管理后台（独立 origin）：按实际部署追加，如 https://office.example.com。
CORS_ALLOW_ORIGINS=app://agentcore,https://office.example.com,https://localhost,capacitor://localhost,http://localhost

# ── Cookie（生产强制 HTTPS）──
# 桌面端 renderer（app://agentcore）与本 API 跨站，cookie 必须 SameSite=None + Secure
# 才会随凭据跨源请求发送；两者缺一桌面端登录会静默失败（启动期 fail-closed 校验）。
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# API 经 Nginx 反代挂在 /api/ 下（app.example.com/api → :8000），故 refresh cookie 的
# path 必须带上该前缀，否则浏览器按 RFC 6265 不会把 cookie 发往 /api/v1/auth/refresh →
# 刷新静默失败、access 一过期即掉登录。须与 Nginx location 前缀一致；dev 留空（API 在根）。
COOKIE_PATH_PREFIX=/api

# ── Server ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Structured event log (JSONL): omit or leave empty → stdout only (no file).
# Set to enable the file sink — scripts/log_stats.py + log sync rely on it.
LOG_FILE=logs/prod.jsonl

# ── 构建溯源（由发布流水线/部署脚本注入，经 GET /version 暴露）──
# 一般由部署脚本自动写入当前 git SHA 与构建时间，无需手填；缺省时 /version 回 "unknown"。
# GIT_SHA=<deploy 时注入的 git sha>
# BUILT_AT=<deploy 时注入的 ISO8601 时间>


# ── 服务端数据目录（MVP 长期记忆文件等）──
# 宿主机直跑 uv/systemd 时用此路径；容器化部署下 docker-compose.app.yml 会把
# 它覆盖为容器内 /data（挂 appdata 卷），此值仅对非容器运行生效。
DATA_DIR=/opt/agentcore/data

# ── 可观测 · 健康巡检告警（部署与运维.md §7.8）──
# 巡检 timer（deploy/systemd/agentcore-healthcheck.*）轮询 /readyz，连续失败推飞书。
# ⚠️ 此项由 healthcheck.sh 从 $AGENTCORE_HOME/.env（即 /opt/agentcore/.env）读取，
# **不走 compose / 不被应用读**——请写进那个运维级 .env，而非本 app 模板。
# 未配则降级 journald（journalctl -u agentcore-healthcheck.service）。
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME
# ALERT_KEYWORD=AgentCore          # 飞书机器人「自定义关键词」安全模式需与此一致

# ── Admin MFA（TOTP）──
# true = 管理后台强制双因素认证；false = 仅密码登录（会话隔离仍生效，admin 不能登桌面）。
# 内测/个人运维可暂设 false，对外运营前改回 true。
ADMIN_MFA_REQUIRED=true

# ── AI Town / 恋综模拟（开发默认 True；生产须显式关闭，避免误开 REST）──
SIMULATION_ENABLED=false

# ── 桌面自动更新（发布与门禁.md §7.6）──
# 熔断：DESKTOP_UPDATES_ENABLED=false 暂停下载坏版本（客户端 fail-open）。
# 硬地板：DESKTOP_MIN_VERSION 经 GET /updates/policy.min_desktop_version 下发，
# 且服务端对 X-Client-Platform=desktop 且版本更旧的 /v1/* 返回 426 CLIENT_TOO_OLD。
# 空 = 不拦（dev 友好）。生产建议地板 0.6.25。
# DESKTOP_UPDATES_ENABLED=true
# DESKTOP_MIN_VERSION=0.6.25

# ── 原生手机端硬地板（发布与门禁.md §7.6a）──
# MOBILE_MIN_VERSION：服务端对**原生安装包**（X-Client-Platform=android / ios /
# mobile）且版本更旧的 /v1/* 返回 426 CLIENT_TOO_OLD，与桌面地板同语义、各自独立。
# 只挡装在手机上、须用户主动更新的形态；mobile-web 是浏览器面（刷新即最新）**不设地板**。
# fail-open 同桌面：缺 X-Client-Version / dev / 版本解析失败一律放行；
# /livez /readyz /version /updates/policy 与 OPTIONS 豁免。
# 不经 /updates/policy 下发：Android 壳查版本走品牌域 CDN android/latest.json（§7.6a），
# 从不打这个端点；旧包被挡后只能从 426 的 details.min_version 得知地板，再去下新 APK。
# **默认留空 = 不启用**：抬地板是发布时单独的人工动作（一填旧 Android 立刻被挡在门外），
# 不要因为部署新版就顺手填上。
# MOBILE_MIN_VERSION=

# ── 原生推送 FCM（认证与会话.md §十）──
# 默认关闭：关闭时 turn 零开销（不查库、不发送）。开启后，回合因 plan_review / ask_user
# 持久暂停（「需要你」）时向该用户已注册的手机设备推送通知。
# 开启三步，缺一不推：
#   1. 取凭据：Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥 → 下载 JSON
#      （含 client_email / private_key / project_id）。私钥文件，**绝不入仓**。
#   2. 放凭据：传到本文件同级的 credentials/firebase-service-account.json（该目录内容
#      已 gitignore）；docker-compose.app.yml 把它只读挂进 api 容器 /run/secrets/。
#      容器以非 root 运行：文件须 chmod 0644、credentials/ 须 0755，否则读不到。
#      （宿主还有别的非特权用户时可收紧：chown 到容器内 uid —— `docker compose ... exec
#      api id -u` —— 再 chmod 0600。）
#   3. 开关：下面改 PUSH_ENABLED=true 并放开 FCM_SERVICE_ACCOUNT_PATH，然后**重启 api
#      容器**（`docker compose ... up -d` 检测到 env 变化会 recreate）。env 在建容器时
#      注入，且 sender 在进程内 lru_cache 只构建一次——改本文件不会热生效。
# ⚠️ 配错是静默降级而非报错：路径为空 / 文件读不到 / JSON 缺字段 → api 照常启动，只是不推，
# 仅在日志留 push.fcm_unconfigured 或 push.fcm_init_failed。开完请查日志确认没有这两条。
# 手机端另需打包时带 android/app/google-services.json 才会注册设备（apps/mobile/README）。
PUSH_ENABLED=false
# 留空 = 取 JSON 里的 project_id；仅当服务账号所属项目与目标项目不一致时才显式写。
# FCM_PROJECT_ID=
# 容器内路径（对应上面的只读挂载）；宿主机直跑 uv/systemd 时改填宿主机绝对路径。
# FCM_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
