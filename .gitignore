# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# uv
.uv/

# Python tooling caches (ruff / mypy)
.mypy_cache/
.ruff_cache/

# Node / pnpm
node_modules/
.pnpm-store/

# Electron
out/
release/
# pnpm shoot 截图（须在 out/ 外，避免 electron-builder 误打进安装包）
# 通配所有 shoot-out 变体（-manual/-whiteboard/-finale/-slice2…），新增目录不必再逐条枚举
apps/desktop/shoot-out*/
# pnpm smoke:webapp 截图（同上：web 冒烟产物，不入仓 / 不打包）
apps/desktop/smoke-out/
# pnpm e2e 交互自检产物（失败截图 / trace / html report）
apps/desktop/e2e-results/
apps/desktop/e2e-report/
# demo-tape 回放/保真自检产物（smoke-demo-tape / fidelity_check 写出）
apps/desktop/demo-tape-out/
demo-tape-out/
# 服务端本地 eval / conformance 基线草稿（一次性产物，不入仓）
apps/server/eval-tmp/
apps/server/eval-out/
apps/server/.conformance-baseline-refactor/
# web 客户端构建产物（渲染层跑浏览器，形态 A）——由 deploy:web / deploy-web.yml 的
# build:webapp 每次重新构建，不入仓。
apps/desktop/dist-web/
# 临时截图评审产物（配色 / 卡片 / 房间视觉自检）——同 shoot-out，不入仓 / 不打包。
apps/desktop/color-review/
apps/desktop/shoot-fix/
apps/desktop/shoot-room/
apps/desktop/e2e-shots/
apps/desktop/verdict-shots/
apps/desktop/.lint-out.txt
# website 预览自检截图（.shots + shoot 矩阵产物，不入仓）
apps/website/.shots/
apps/website/shoot-out*/
# 内置 Python 运行时（sidecar 打包产物，由 apps/desktop/scripts/bundle-sidecar.mjs 生成）
apps/desktop/resources/sidecar/
# 内嵌 ripgrep（产品 AI grep；fetch_ripgrep.py / pnpm fetch:rg）
apps/desktop/resources/rg/
apps/server/bin/
# apps/desktop/build/ 是 electron-builder 的 buildResources（应用图标源），不是上面 Python
# 通用 `build/` 产物——解除目录忽略、再忽略目录内容、只放行平台图标入仓（Mac cropped / Win rounded）。
!apps/desktop/build/
apps/desktop/build/*
!apps/desktop/build/icon-mac.png
!apps/desktop/build/icon-win.png

# TS build info / lint cache
*.tsbuildinfo
.eslintcache

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env*
!.env.example
!.env.*.example
# Intentionally tracked: public API URL only (no secrets)
!apps/desktop/.env.production
!apps/mobile/.env.production
# Local probe script outputs
apps/server/.pytest-result.txt
apps/server/_pytest*.txt
apps/server/_pf*.txt
# Ad-hoc underscore-prefixed one-off scripts + scratch outputs (.py/.txt/.json) dropped
# under apps/server/scripts by parallel probe/analysis sessions — not release artifacts.
# Already-tracked _mlr_*.py stay tracked; this only stops NEW underscore scratch landing.
apps/server/scripts/_*
apps/server/scripts/tmp_*
# Ad-hoc probe/debug scratch dir (pytest chunks, trace dumps, debate exports, grad runs)
apps/server/tmp/
# Session audit / log dumps dropped at repo root or under apps/server (not release artifacts)
/tmp_*
/_tmp_*
/.tmp_*
# Log-patrol scratch at repo root (often carries conversation bodies)
/.cursor-tmp-*
# Local scratch dump dir at repo root only (leading slash; not apps/**/.tmp)
/.tmp/
apps/server/_tmp_*
apps/server/tmp_*
# One-off review / audit scratch (maintainer-local; not published)
/reviews/
# 桌面临时自检脚本（tmp- 前缀 = 用完即删；正式探针请用无前缀名并挂进 package.json）
apps/desktop/scripts/tmp-*
# 浏览器工具链的分步调试截图（browser_* 工具落盘），仓库根 only
/browser/
# PowerShell 里 `uv run python -c "… >= …"` 之类误重定向产出的字面量文件
=
# Planning / proposal drafts (maintainer-local; not published — keep on disk)
docs/06-规划/
# Cursor agent transcripts (local IDE); never ship
agent-transcripts/
# Real production secrets (created on the server from production.env.example)
deploy/config/production.env

# Certificates / keystores (private material). Public .pem in-tree: re-narrow if needed.
*.pem
*.key
*.p12
*.jks
*.keystore
**/keystore.properties
# Firebase / FCM client config (contains project identifiers; keep local)
**/google-services.json
# Firebase / FCM *server* credential (service-account JSON = a private key). Lives in
# deploy/config/credentials/ on the server (that dir has its own .gitignore); this rule
# also covers a dev copy dropped next to apps/server/.env.
**/firebase-service-account.json

# Cloudflare Wrangler local state
.wrangler/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / Coverage
htmlcov/
.coverage
.coverage.*
# pytest cache + ad-hoc --basetemp scratch dirs (test artifacts)
.pytest_*/
.pytmp/
._pytmp/
.tmp_pytest/
.pytest_out.txt
coverage/

# Build artifacts
*.so
*.dylib
*.dll

# Logs
*.log
logs/
# Conversation timeline exports (stdout dumps from scripts/log_timeline.py)
_*_timeline.txt
# log_timeline --pack investigation packs (may include messages.json)
apps/server/_pack_*/
apps/server/--full/
apps/server/--trace/

# Database
*.db
*.sqlite3

# Docker volumes (local dev)
.docker-data/

# Local throwaway tooling artifacts (cookie-verify harness output: cloudflared
# binary, self-signed certs incl. private key, logs, evidence json — all regenerated)
.tools/

# Server local data (MVP long-term memory files, see apps/server/agentcore/memory/store.py)
apps/server/data/
data/

# Retired AI Town: Unity Library cache may remain on old checkouts
/apps/town/

# Eval fixture workspaces may grow AgentCore/ trash when a probe mutates them
apps/server/agentcore/evals/fixtures/**/.agentcore/

# Accidental nested clone / probe drop of this repo at the workspace root
# (may contain code_search.db ~90MB+). Leading slash = repo root only; do not
# match docs/ or other paths named AgentCore.
/AgentCore/

# Cursor 对话存档（PChat 生成的上下文归档，不应进入代码仓库）
杂项/
# 聊天里粘贴的图片/附件落盘（hex 命名，可能含用户材料），仓库根 only
/attachments/

# Dev-only demo tape session bindings (local conversation_id → tape map)
demos/bindings.json
demos/tapes/_*.json
# Full-session demo tapes / promo capture media (real runs — keep local, do not publish)
demos/tapes/*.json
apps/promo/assets/**/clips/
apps/promo/assets/**/stills/
apps/promo/assets/**/manifest.json
# Dev-only live-stream recordings (DEMO_TAPE_RECORD_ENABLED tap output; may carry
# real conversation content — export curated tapes into demos/tapes/ instead)
demos/recordings/
